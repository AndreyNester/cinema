@startuml
skinparam linetype ortho
skinparam nodesep 150
skinparam ranksep 300

!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
LAYOUT_LEFT_RIGHT()


title C4 Context: Кинобездна (онлайн-кинотеатр)

Person(user, "Пользователь", "Смотрит фильмы, ставит оценки, добавляет в избранное, оформляет подписку.")
Person(admin, "Контент-менеджер/Админ", "Управляет каталогом и метаданными, акциями, проверяет платежи.")

System_Boundary(cin, "Кинобездна") {
  System(system, "Кинобездна (приложение)", "Доступ к каталогу, метаданным, подпискам, избранному и рекомендациям через API (BFF для устройств).")
}

System_Ext(streaming, "Внешний стриминг/видеохостинг", "Хранит и раздает видео (стриминг).")
System_Ext(reco, "Внешняя рекомендательная система", "Возвращает подборки/рекомендации по пользователю/контенту.")
System_Ext(pay, "Платежный провайдер", "Обработка платежей и статусов транзакций.")

Rel(user, system, "Использует", "Web/Mobile/SmartTV")
Rel(admin, system, "Администрирует", "Web Admin")

Rel(system, streaming, "Запрашивает воспроизведение/URL/права показа", "HTTPS/API")
Rel(system, reco, "Запрашивает рекомендации", "HTTPS/API")
Rel(system, pay, "Создает/проводит платежи, получает статусы", "HTTPS/Webhooks")

@enduml
